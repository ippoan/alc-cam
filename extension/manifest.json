{
  "manifest_version": 3,
  "name": "alc-cam 拠点中継",
  "version": "0.2.0",
  "description": "サイドパネルを開いている間だけ、拠点のカメラ (RTSP) を WebRTC で見る側へ P2P で届ける。中身は native messaging の alc-cam-host (Rust)",
  "key": "",
  "permissions": [
    "storage",
    "sidePanel",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "alc-cam 拠点中継を開く"
  }
}
