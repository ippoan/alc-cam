{
  "manifest_version": 3,
  "name": "alc-cam 拠点中継",
  "version": "0.4.2",
  "description": "Chrome が動いている間ずっと、拠点のカメラ (RTSP) を WebRTC で見る側へ P2P で届ける (見る人が来たときだけカメラに繋ぐ)。中身は native messaging の alc-cam-host (Rust)",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "storage",
    "alarms",
    "sidePanel",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://auth.ippoan.org/*"
  ],
  "externally_connectable": {
    "matches": ["https://alc.ippoan.org/*"]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "alc-cam 拠点中継を開く"
  }
}
