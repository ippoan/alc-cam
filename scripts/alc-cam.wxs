<?xml version="1.0" encoding="utf-8"?>
<!--
  拠点 PC に alc-cam を入れる MSI (scripts/build-msi.ps1 が wix 5.0.2 で作る。管理者権限は要らない)。
    %LOCALAPPDATA%\alc-cam\alc-cam-host.exe              host
    %LOCALAPPDATA%\alc-cam\org.ippoan.alc_cam_host.json  native messaging の manifest (BOM なし。path は隣の exe への相対)
    %LOCALAPPDATA%\alc-cam\extension\                    拡張 (chrome://extensions で 1 回だけ読み込む)
    HKCU\Software\Google\Chrome\NativeMessagingHosts\org.ippoan.alc_cam_host = manifest の場所

  自己更新 (host/src/update.rs) との両立:
    - exe と拡張の部品は NeverOverwrite。KeyPath は「その版で入れた」印の HKCU の値 (名前に ProductVersion を含む) なので、
      同じ版の修復 (msiexec /f・.msi の右クリックの「修復」) では印があって入れ直さない = host が書き換えた版のまま。
      新しい MSI では印の名前が変わるので入る (古い版は MajorUpgrade が先に外す)
    - 修復の口を減らす: ショートカット・広告 (advertise) は作らない、「アプリと機能」の修復・変更は出さない
    - アンインストールでは util:RemoveFolderEx でフォルダごと消す (自己更新の .old・.new-*・extension.old-* も)
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="alc-cam 拠点中継" Manufacturer="ippoan" Version="$(var.Version)" UpgradeCode="F4D08D75-0E62-41C4-80E8-95042CEEDC98"
           Scope="perUser" Language="1041" Codepage="932">
    <SummaryInformation Codepage="932" Description="alc-cam 拠点中継 (host と Chrome 拡張)" />
    <MediaTemplate EmbedCab="yes" />
    <!-- 古い MSI で下げない (同じ版の入れ直しは保守モードで何もしない) -->
    <MajorUpgrade DowngradeErrorMessage="新しい版の alc-cam が入っています。この MSI では入れられません。" />

    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <!-- アンインストールで消すフォルダ (RemoveFolderEx は CostInitialize より前に読むので、ディレクトリではなく入れたときの値から引く) -->
    <Property Id="ALCCAMDIR">
      <RegistrySearch Id="AlcCamDir" Root="HKCU" Key="Software\ippoan\alc-cam" Name="InstallDir" Type="raw" />
    </Property>

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="alc-cam" />
    </StandardDirectory>

    <Feature Id="Main">
      <ComponentRef Id="Registration" />
      <ComponentRef Id="HostExe" />
      <ComponentGroupRef Id="Extension" />
    </Feature>

    <!-- 登録 (自己更新は触らないので修復してよい) -->
    <Component Id="Registration" Directory="INSTALLFOLDER" Guid="B0CF3B7D-4978-44FE-931A-D18DC3DB92DA">
      <File Id="HostManifest" Source="$(var.HostManifest)" Name="org.ippoan.alc_cam_host.json" />
      <RegistryKey Root="HKCU" Key="Software\Google\Chrome\NativeMessagingHosts\org.ippoan.alc_cam_host" ForceDeleteOnUninstall="yes">
        <RegistryValue Type="string" Value="[#HostManifest]" KeyPath="yes" />
      </RegistryKey>
      <RegistryKey Root="HKCU" Key="Software\ippoan\alc-cam" ForceDeleteOnUninstall="yes">
        <RegistryValue Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" />
      </RegistryKey>
      <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
      <util:RemoveFolderEx Id="RemoveAll" On="uninstall" Property="ALCCAMDIR" />
    </Component>

    <!-- host (自己更新が書き換える) -->
    <Component Id="HostExe" Directory="INSTALLFOLDER" Guid="E3FBA599-20C8-42CF-922E-7B937508080A" NeverOverwrite="yes">
      <File Id="HostExe" Source="$(var.HostExe)" Name="alc-cam-host.exe" />
      <RegistryValue Root="HKCU" Key="Software\ippoan\alc-cam\Installed" Name="host [ProductVersion]" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- 入れ終わりの画面: ようこそ → 入れる → 拡張の読み込み手順 (自前の AlcCamExitDlg)。
         WiX 標準の ExitDialog の追加の文 (WIXUI_EXITDIALOGOPTIONALTEXT) は「NOT Installed」のときしか出ず
         (同じ版の入れ直し = 保守モードでは出ない)、欄も 6〜7 行ぶんでフォルダの行が切れるので使わない -->
    <!-- 拡張のフォルダ (完了画面の欄に出す。選んでコピーできる) と、[完了] で開く先 (util の WixShellExec が読む) -->
    <SetProperty Id="ALCCAM_EXTDIR" After="CostFinalize" Sequence="ui" Value="[INSTALLFOLDER]extension" />
    <Property Id="WixShellExecTarget" Value="[INSTALLFOLDER]extension" />
    <Property Id="ALCCAM_OPENFOLDER" Value="1" />
    <CustomAction Id="OpenExtFolder" BinaryRef="Wix4UtilCA_X64" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
    <UI Id="AlcCamUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="WelcomeDlg" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="EndDialog" Value="Return" Order="2" />

      <Dialog Id="AlcCamExitDlg" Width="370" Height="270" Title="[ProductName] セットアップ">
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}alc-cam を入れました" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="最後に Chrome で拡張を 1 回だけ読み込みます (以後の更新は自動)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Steps" Type="Text" X="20" Y="51" Width="330" Height="104" NoPrefix="yes"
                 Text="1. Chrome で chrome://extensions を開き、右上の「デベロッパー モード」を ON にする (OFF に戻さない)&#13;&#10;2. 前に別の場所から読み込んだ「alc-cam 拠点中継」があれば「削除」&#13;&#10;3. 下の「フォルダを開く」を ON のまま [\[]完了[\]] を押すと拡張のフォルダが開くので、そのフォルダ (extension) を chrome://extensions の画面へドラッグ&amp;ドロップする&#13;&#10;　または「パッケージ化されていない拡張機能を読み込む」で下のフォルダを選ぶ (欄の文字は選んでコピーできる)" />
        <Control Id="ExtDirLabel" Type="Text" X="20" Y="156" Width="330" Height="12" NoPrefix="yes" Text="拡張のフォルダ:" />
        <Control Id="ExtDir" Type="Edit" X="20" Y="169" Width="330" Height="18" Property="ALCCAM_EXTDIR" Sunken="yes" />
        <Control Id="OpenFolder" Type="CheckBox" X="20" Y="196" Width="330" Height="17" Property="ALCCAM_OPENFOLDER" CheckBoxValue="1" Text="[\[]完了[\]] でこのフォルダを開く" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="!(loc.WixUIBack)" />
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="!(loc.WixUIFinish)">
          <Publish Event="DoAction" Value="OpenExtFolder" Condition="ALCCAM_OPENFOLDER = 1" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Disabled="yes" Text="!(loc.WixUICancel)" />
      </Dialog>
      <InstallUISequence>
        <Show Dialog="AlcCamExitDlg" OnExit="success" />
      </InstallUISequence>
    </UI>
    <UIRef Id="WixUI_Common" />
  </Package>
</Wix>
